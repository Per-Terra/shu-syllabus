    "schedule": [
        {
            "number": "1",
            "content": "社会や地域の課題解決のために、経済学や経営学の視点が有用であることを学ぶ。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "佐藤　裕哉"
            ]
        },
        {
            "number": "2",
            "content": "地図や統計データ、フィールドワークの成果を用いながら、地域・空間・場所といった地理学の視点から山口県や周南地域など身近な地域の経済や社会について概説する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "佐藤　裕哉"
            ]
        },
        {
            "number": "3",
            "content": "私たちの暮らす地域を「コミュニティ」という視点から、その役割やなぜ地域コミュニティをつくることが必要なのか、地域の構造変容の過程と持続的な地域の在りようについて学ぶ。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "稲垣　円"
            ]
        },
        {
            "number": "4",
            "content": "地域デザインとは何か、研究と実践の両面から考察する。加えてデザイン思考を活用した地域デザインの事例を紹介する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "赤木　真由"
            ]
        },
        {
            "number": "5",
            "content": "日本におけるエンターテインメント・ビジネスの経済規模について。「ミリオンセラー＝100万人に売れるとなぜ大ヒットなのか」の意味と波及効果、YouTubeやクラウドファンディングに見られる「評価経済社会」の在り方についても言及する。",
            "teaching_methods": [
                "講義",
                "演習"
            ],
            "teachers": [
                "長澤　雅彦"
            ]
        },
        {
            "number": "6",
            "content": "現在の日本や海外の経済情勢等を踏まえ、今後の日本においてどのような経済政策が必要なのか説明する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "岩本　直"
            ]
        },
        {
            "number": "7",
            "content": "都市集中、地域間格差、人口減少問題など、現代の都市・地域が直面する諸課題とメカニズムについて紹介する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "伏木　貞文"
            ]
        },
        {
            "number": "8",
            "content": "経済学・経営学をデータの面から見る際に、統計学の知識が必要となる。どのような統計的手法を用いればどのような分析が行えるのかを、実際の分析例を通して学んでいく。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "河田　正樹"
            ]
        },
        {
            "number": "9",
            "content": "自分が考えた地域振興策を行うといくらの経済波及効果が生まれるのか、電力価格が１％上昇すると使用電力は何％減少するのかなど、身近な事例を通じて研究を進める上で必要となる実証分析について、その理論と方法を説明する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "村岡　浩次"
            ]
        },
        {
            "number": "10",
            "content": "金融は情報技術の発展とともに急速に進展している。本講義では金融論の概要を紹介し、日本の金融状況について説明する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "長澤　賢一"
            ]
        },
        {
            "number": "11",
            "content": "合理的経済人の想定による標準的な経済学の例を紹介した上で、その単純な想定から外れた人間行動を考える行動経済学の意義を紹介する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "田島　正士"
            ]
        },
        {
            "number": "12",
            "content": "事例を用いながら「ニーズ」、「ウォンツ」を整理し、ターゲットに刺さるマーケティングについて考察する。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "髙橋　真実"
            ]
        },
        {
            "number": "13",
            "content": "大企業と中小企業は経営資源であるヒト・モノ・カネ・情報が異なるという特徴がある。この違いから生まれる様々な課題を理解し解決策を考える。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "百武　仁志"
            ]
        },
        {
            "number": "14",
            "content": "グローバル化は国際政治の論理と国際経済の論理の相克をもたらしている。そこから生じる問題を取り上げて概説し、解決策を考える。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "岡本　次郎"
            ]
        },
        {
            "number": "15",
            "content": "国際ビジネスの多様性を知るとともに、グローバル企業の成長と世界経済の関係について考える。",
            "teaching_methods": [
                "講義"
            ],
            "teachers": [
                "WEI　DI"
            ]
        }
